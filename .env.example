NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only: signs browser uploads (src/shared/lib/cloudinary/actions.ts).
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MAPY_API_KEY=
# Public origin for canonical URLs, Open Graph, robots.txt and the sitemap,
# e.g. https://findpaw.cz in production. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Cloudflare Turnstile site key for the auth forms. The secret key goes only to
# Supabase Dashboard → Authentication → Attack Protection. Leave empty to hide
# the widget (local Supabase stack without captcha).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Sentry error reporting (EU region). Empty DSN turns Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, set in Vercel: uploads source maps for readable stack traces.
SENTRY_AUTH_TOKEN=
